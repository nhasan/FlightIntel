<!-- One altitude of a winds aloft forecast, in columns that line up from
     row to row: the same widths, right-aligned, with tabular digits -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="@dimen/item_padding"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
    <TextView android:id="@+id/winds_altitude"
            style="@style/TextSmall"
            android:fontFeatureSettings="tnum"
            android:layout_weight="1"
            android:layout_width="0dp"
            android:layout_height="wrap_content" />
    <TextView android:id="@+id/winds_wind"
            style="@style/TextSmall"
            android:fontFeatureSettings="tnum"
            android:gravity="end"
            android:layout_weight="1.3"
            android:layout_width="0dp"
            android:layout_height="wrap_content" />
    <TextView android:id="@+id/winds_temperature"
            style="@style/TextSmall"
            android:fontFeatureSettings="tnum"
            android:gravity="end"
            android:layout_weight="0.7"
            android:layout_width="0dp"
            android:layout_height="wrap_content" />
</LinearLayout>
