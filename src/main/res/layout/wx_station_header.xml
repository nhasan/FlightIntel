<!-- The weather station, shown once above the weather tabs, with its phone
     and frequencies inside the title's shaded section -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
        android:orientation="vertical"
        android:background="?colorTertiary"
        android:paddingBottom="@dimen/label_padding"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
    <include android:id="@+id/wx_title"
            layout="@layout/wx_title_layout" />
    <include android:id="@+id/wx_subtitle"
            layout="@layout/wx_subtitle_layout" />
</LinearLayout>
