<FrameLayout
        xmlns:android="http://schemas.android.com/apk/res/android"
        android:id="@+id/main_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
    <org.osmdroid.views.MapView
            android:id="@+id/dof_map"
            android:visibility="invisible"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />
    <!-- Shown until the obstacles are known, and when none are found -->
    <TextView
            android:id="@+id/dof_map_status"
            style="@style/TextSmall"
            android:background="@drawable/rounded_rectangle"
            android:padding="@dimen/item_padding"
            android:layout_margin="@dimen/item_padding"
            android:layout_gravity="center"
            android:gravity="center"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />
    <!-- How to see an obstacle's details, until the user first does. Where
         the details then show, above the scale bar and attribution. -->
    <TextView
            android:id="@+id/dof_map_hint"
            style="@style/TextSmall"
            android:text="@string/dof_map_hint"
            android:background="@drawable/rounded_rectangle"
            android:paddingStart="@dimen/item_padding"
            android:paddingEnd="@dimen/item_padding"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:layout_marginBottom="48dp"
            android:layout_gravity="bottom|center_horizontal"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />
    <!-- The tapped obstacle, above the scale bar and attribution -->
    <TextView
            android:id="@+id/dof_map_details"
            style="@style/TextSmall"
            android:background="@drawable/rounded_rectangle"
            android:padding="@dimen/item_padding"
            android:layout_marginStart="@dimen/item_padding"
            android:layout_marginEnd="@dimen/item_padding"
            android:layout_marginBottom="48dp"
            android:layout_gravity="bottom"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />
</FrameLayout>
